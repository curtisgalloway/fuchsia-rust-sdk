# Copied from fuchsia.git build/config/rust/lints/BUILD.bazel at the lock's
# fuchsia_revision (b5274053cc0f); the rustc_* macros in //rules:rustc.bzl use these as
# their lint_config defaults, as upstream's do. The Fuchsia LICENSE is
# LICENSES/BSD-2-Clause.txt. The changes are marked "Overlay:"; the LINT.IfChange
# markers name upstream paths.

load("@rules_rust//rust:defs.bzl", "rust_lint_config")

# Overlay: upstream also sets default_applicable_licenses = ["//:license"].
package(
    default_visibility = ["//visibility:public"],
)

_CLIPPY_WARN_DEFAULT = {
    # Allow everything by default, except for the ones explicitly configured.
    # LINT.IfChange(clippy_warn_default)
    "all": "allow",
    "await_holding_lock": "warn",
    "clear_with_drain": "warn",
    "confusing_method_to_numeric_cast": "warn",
    "correctness": "warn",
    "expect_fun_call": "warn",
    "fn_to_numeric_cast_with_truncation": "warn",
    "into_iter_on_ref": "warn",
    "large_enum_variant": "warn",
    "large_futures": "warn",
    "missing_safety_doc": "warn",
    "or_fun_call": "warn",
    "unnecessary_mut_passed": "warn",
    # LINT.ThenChange(//build/config/rust/lints/BUILD.gn:clippy_warn_default)
}

_CLIPPY_WARN_PRODUCTION = _CLIPPY_WARN_DEFAULT | {
    # LINT.IfChange(clippy_warn_production)
    "collection_is_never_read": "warn",
    "needless_collect": "warn",
    "perf": "warn",
    "redundant_clone": "warn",
    "set_contains_or_insert": "warn",
    "unnecessary_lazy_evaluations": "warn",
    # LINT.ThenChange(//build/config/rust/lints/BUILD.gn:clippy_warn_production)
}

# The same rustc lint configs are applied to all Rust targets.
_RUSTC_LINT_CONFIGS = {
    # LINT.IfChange(rustc_allow_default)
    "unknown_lints": "allow",
    # LINT.ThenChange(//build/config/rust/lints/BUILD.gn:rustc_allow_default)

    # LINT.IfChange(rustc_warn_default)
    "missing_unsafe_on_extern": "warn",
    "unsafe_attr_outside_unsafe": "warn",
    "unused_crate_dependencies": "warn",
    # LINT.ThenChange(//build/config/rust/lints/BUILD.gn:rustc_warn_default)

    # LINT.IfChange(rustc_deny_default)
    "deref_nullptr": "deny",
    "invalid_value": "deny",
    "unused_must_use": "deny",
    # LINT.ThenChange(//build/config/rust/lints/BUILD.gn:rustc_deny_default)

    # LINT.IfChange(rustc_toolchain_roll_exceptions)
    "mismatched_lifetime_syntaxes": "allow",
    "non_local_definitions": "allow",
    "renamed_and_removed_lints": "allow",
    "rustdoc::redundant_explicit_links": "allow",
    # LINT.ThenChange(//build/config/rust/lints/BUILD.gn:rustc_toolchain_roll_exceptions)
}

rust_lint_config(
    name = "clippy_warn_default",
    clippy = _CLIPPY_WARN_DEFAULT,
    rustc = _RUSTC_LINT_CONFIGS,
)

rust_lint_config(
    name = "clippy_warn_production",
    clippy = _CLIPPY_WARN_PRODUCTION,
    rustc = _RUSTC_LINT_CONFIGS,
)

rust_lint_config(
    name = "clippy_warn_all",
    # In Bazel, `lint_config` replaces default lint configs rather than
    # appending as GN does.
    #
    # We bake `_CLIPPY_WARN_PRODUCTION` in because `clippy::all` only covers
    # default groups (correctness, style, complexity, perf, suspicious) and
    # omits nursery and pedantic lints enabled by our default configs (e.g.
    # `collection_is_never_read`, `large_futures`).
    # See https://doc.rust-lang.org/clippy/index.html
    clippy = _CLIPPY_WARN_PRODUCTION | {
        "all": "warn",
    },
    rustc = _RUSTC_LINT_CONFIGS,
)

rust_lint_config(
    name = "clippy_allow_all",
    clippy = {
        "all": "allow",
    },
    rustc = _RUSTC_LINT_CONFIGS,
)

# Overlay (milestone M8): the lints GN gives FIDL Rust bindings (build/rust/fidl_rust.gni:
# rustc_library's defaults with disable_clippy, plus the configs
# //build/config/rust/lints:allow_unused_crate_dependencies and :deny_unused_results).
# //rules:fidl_rust.bzl uses it; upstream's Bazel rule sets no lint config. The rust_next
# bindings (build/rust/fidl_rust_next.gni) get the same configs: //rules:fidl_rust_next.bzl
# uses it too (M8b).
rust_lint_config(
    name = "fidl_rust",
    clippy = {
        "all": "allow",
    },
    rustc = _RUSTC_LINT_CONFIGS | {
        "unused_crate_dependencies": "allow",
        "unused_results": "deny",
    },
)

# Overlay (milestone M10): the lints GN gives Rust drivers. set_defaults("fuchsia_rust_driver")
# (build/drivers/fuchsia_driver.gni) is rustc_cdylib's defaults plus the config
# //build/config/rust/lints:allow_unused_crate_dependencies (fxbug.dev/42055130: "The build
# fails if unused crates are removed at call sites"); rustc_* targets default to
# clippy_warn_production, so this is clippy_warn_production with that one lint allowed.
# //rules:fuchsia_rust_driver.bzl uses it as fuchsia_rust_driver's default lint_config.
rust_lint_config(
    name = "fuchsia_rust_driver",
    clippy = _CLIPPY_WARN_PRODUCTION,
    rustc = _RUSTC_LINT_CONFIGS | {
        "unused_crate_dependencies": "allow",
    },
)

# Overlay (milestone M10): the lints GN gives a bind library's Rust crate
# (build/bind/bind.gni, _bind_library_rust: rustc_library's defaults plus the config
# //build/config/rust/lints:deny_unused_results). //rules:bind_rust.bzl uses it.
rust_lint_config(
    name = "bind_rust",
    clippy = _CLIPPY_WARN_PRODUCTION,
    rustc = _RUSTC_LINT_CONFIGS | {
        "unused_results": "deny",
    },
)
