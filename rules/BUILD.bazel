# The overlay's Rust rules (design §4.2 "Rust rules"): rustc.bzl (rustc_library,
# rustc_binary, rustc_proc_macro), and rustc_api_level.bzl with api_level.bzl, which the
# Rust toolchains (toolchain/rust.BUILD.bazel) use for the API-level cfgs; host.bzl, which
# vendored Go BUILD files load their host constraints from (M7); fidl.bzl (fidl_library)
# and fidl_rust.bzl (its Rust bindings), which vendored FIDL libraries load (M8), and
# build_info.bzl, the build arguments vendored BUILD files read (M8); fidl_rust_next.bzl,
# the rust_next bindings and the allowlist the vendored fidl_next crates load (M8b);
# fuchsia_rust_driver.bzl (the driver rule and its package tests) and bind_rust.bzl (a
# bind library's Rust crate), M10; bind_test.bzl (`bindc test` on a driver's bind rules), I3.

load(":host.bzl", "HOST_OS_CONSTRAINTS")

# Upstream's //build/bazel/platforms:is_host_os, which scripts/regen.py maps here (M9b):
# vendored BUILD files select() on it for their host branches. Upstream matches the host
# platform's OS constraint; this matches the OS of the machine Bazel runs on (host.bzl).
config_setting(
    name = "is_host_os",
    constraint_values = HOST_OS_CONSTRAINTS,
    visibility = ["//vendor/fuchsia:__subpackages__"],
)

# The scripts of fuchsia_driver_elf_test and fuchsia_driver_manifest_test
# (fuchsia_rust_driver.bzl, M10).
exports_files(
    ["driver_elf_test.sh", "driver_manifest_test.sh"],
    visibility = ["//visibility:public"],
)
