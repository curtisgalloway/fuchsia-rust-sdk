Build fuchsia-sync for Fuchsia only, without lock-cycle detection (milestone M8).

On host, upstream builds it with parking_lot and parking_lot_core: outside pilot 1's
closure (docs/closure/pilot1.json: this crate is used from Fuchsia code only). The host
deps are emptied and the target marked Fuchsia-only. fuchsia_sync_detect_lock_cycles is
False in the overlay (//rules:build_info.bzl, decided after the M6a review), so
DETECT_LOCK_CYCLE_DEPS (forks/tracing-mutex-0.3.2) is emptied too; regen.py would
otherwise copy that fork. The added lines are the overlay's (Apache-2.0); the context
lines are Fuchsia's (BSD-2-Clause, LICENSES/BSD-2-Clause.txt). Applied by
scripts/regen.py to the rewritten BUILD.bazel.

--- a/src/lib/fuchsia-sync/BUILD.bazel
+++ b/src/lib/fuchsia-sync/BUILD.bazel
@@ -30,10 +30,8 @@
 ]
 
 # @bazel2gn:transformer=deps
-FUCHSIA_SYNC_DEPS_HOST = [
-    "@rust_crates//vendor:parking_lot",
-    "@rust_crates//vendor:parking_lot_core",
-]
+# Overlay: no host build (patch 0001).
+FUCHSIA_SYNC_DEPS_HOST = []
 
 # @bazel2gn:transformer=deps
 FUCHSIA_SYNC_TEST_DEPS = ["@rust_crates//vendor:crossbeam"]
@@ -41,7 +39,8 @@
 DETECT_LOCK_CYCLE_FLAGS = ["--cfg=detect_lock_cycles"]
 
 # @bazel2gn:transformer=deps
-DETECT_LOCK_CYCLE_DEPS = ["@rust_crates//forks/tracing-mutex-0.3.2:tracing_mutex"]
+# Overlay: fuchsia_sync_detect_lock_cycles is False in //rules:build_info.bzl (patch 0001).
+DETECT_LOCK_CYCLE_DEPS = []
 
 rustc_library(
     vendored = True,  # Generated by scripts/regen.py
@@ -56,4 +55,6 @@
         "@platforms//os:fuchsia": FUCHSIA_SYNC_DEPS_FUCHSIA,
         "//conditions:default": FUCHSIA_SYNC_DEPS_HOST,
     }) + (DETECT_LOCK_CYCLE_DEPS if fuchsia_sync_detect_lock_cycles else []),
+    # Overlay: Fuchsia only (patch 0001).
+    target_compatible_with = ["@platforms//os:fuchsia"],
 )
