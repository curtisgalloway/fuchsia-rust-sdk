Build fuchsia-fs without its FDomain variant and test deps (milestone M9b).

Pilot 1's closure uses only :fuchsia-fs. :fuchsia-fs_fdomain needs FIDL's fdomain flavor
(not built, //rules:fidl_rust.bzl) and fdomain/client's :flex_fdomain (removed there),
so it is removed; so is the testonly fidl_library fidl.test.schema and its load, which
only the test deps use.

test_deps are dropped: //rules:rustc.bzl makes no unit tests until milestone M16, and
regen.py would otherwise fetch crates outside the closure (assert_matches, proptest,
tempfile) or fail on in-tree test deps it does not vendor (//src/lib/fuchsia).

The added lines are the overlay's (Apache-2.0); the context lines are Fuchsia's
(BSD-2-Clause, LICENSES/BSD-2-Clause.txt). Applied by scripts/regen.py to the rewritten
BUILD.bazel.

--- a/src/lib/fuchsia-fs/BUILD.bazel
+++ b/src/lib/fuchsia-fs/BUILD.bazel
@@ -4,7 +4,6 @@
 # Use of this source code is governed by a BSD-style license that can be
 # found in the LICENSE file.
 
-load("//rules:fidl.bzl", "fidl_library")
 load("//rules:rustc.bzl", "rustc_library")
 
 package(default_applicable_licenses = ["//vendor/fuchsia:license"])
@@ -36,14 +35,8 @@
 ]
 
 # @bazel2gn:transformer=deps
-_COMMON_TEST_DEPS = [
-    ":fidl.test.schema_rust",
-    "//vendor/fuchsia/src/lib/fuchsia",
-    "//vendor/fuchsia/src/storage/lib/vfs/rust:vfs",
-    "@rust_crates//vendor:assert_matches",
-    "@rust_crates//vendor:proptest",
-    "@rust_crates//vendor:tempfile",
-]
+# Overlay: unit tests are milestone M16 (patch 0001).
+_COMMON_TEST_DEPS = []
 
 rustc_library(
     vendored = True,  # Generated by scripts/regen.py
@@ -66,24 +59,6 @@
     }),
 )
 
-rustc_library(
-    vendored = True,  # Generated by scripts/regen.py
-    name = "fuchsia-fs_fdomain",
-    srcs = _COMMON_SRCS,
-    crate_features = ["fdomain"],
-    crate_name = "fuchsia_fs_fdomain",
-    edition = "2024",
-    test_deps = _COMMON_TEST_DEPS,
-    visibility = ["//vendor/fuchsia:__subpackages__"],
-    with_unit_tests = True,
-    deps = _COMMON_DEPS + [
-        "//vendor/fuchsia/sdk/fidl/fuchsia.io:fuchsia.io_rust_fdomain_flex",
-        "//vendor/fuchsia/src/lib/fdomain/client:flex_fdomain",
-    ],
-)
+# Overlay: rustc_library "fuchsia-fs_fdomain" is not built (patch 0001): FIDL's fdomain flavor is not built.
 
-fidl_library(
-    name = "fidl.test.schema",
-    testonly = True,
-    srcs = ["data/schema.test.fidl"],
-)
+# Overlay: fidl_library "fidl.test.schema" is not built (patch 0001): test-only.
