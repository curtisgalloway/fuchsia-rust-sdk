Build fuchsia-async for Fuchsia only, without test deps (milestone M8).

On host, upstream builds it with //src/lib/fuchsia-emulated-handle, tokio
(forks/tokio-1.53.1) and futures-lite: outside pilot 1's closure
(docs/closure/pilot1.json: this crate is used from Fuchsia code only). The host branch is
emptied and the target marked Fuchsia-only. test_deps (assert_matches, futures-test,
rand) are dropped: //rules:rustc.bzl makes no unit tests until milestone M16, and
regen.py would otherwise fetch crates outside the closure. The added lines are the
overlay's (Apache-2.0); the context lines are Fuchsia's (BSD-2-Clause,
LICENSES/BSD-2-Clause.txt). Applied by scripts/regen.py to the rewritten BUILD.bazel.

--- a/src/lib/fuchsia-async/BUILD.bazel
+++ b/src/lib/fuchsia-async/BUILD.bazel
@@ -61,15 +61,8 @@
     proc_macro_deps = [
         "//vendor/fuchsia/src/lib/fuchsia-async-macro",
     ],
-    test_deps = [
-        "@rust_crates//vendor:assert_matches",
-    ] + select({
-        "@platforms//os:fuchsia": [
-            "@rust_crates//vendor:futures-test",
-            "@rust_crates//vendor:rand",
-        ],
-        "//conditions:default": [],
-    }),
+    # Overlay: unit tests are milestone M16 (patch 0001).
+    test_deps = [],
     with_host_unit_tests = True,
     deps = [
         "//vendor/fuchsia/src/lib/fuchsia-sync",
@@ -87,10 +80,9 @@
             "@rust_crates//vendor:socket2",
             "@rust_crates//vendor:zerocopy",
         ],
-        "//conditions:default": [
-            "//vendor/fuchsia/src/lib/fuchsia-emulated-handle",
-            "@rust_crates//vendor:futures-lite",
-            "@rust_crates//vendor:tokio",
-        ],
+        # Overlay: no host build (patch 0001).
+        "//conditions:default": [],
     }),
+    # Overlay: Fuchsia only (patch 0001).
+    target_compatible_with = ["@platforms//os:fuchsia"],
 )
