Build cm_fidl_validator without its test deps (milestone M9b).

test_deps are dropped: //rules:rustc.bzl makes no unit tests until milestone M16, and
regen.py would otherwise fetch crates outside the closure (proptest, regex, test-case).

The added lines are the overlay's (Apache-2.0); the context lines are Fuchsia's
(BSD-2-Clause, LICENSES/BSD-2-Clause.txt). Applied by scripts/regen.py to the rewritten
BUILD.bazel.

--- a/src/sys/lib/cm_fidl_validator/BUILD.bazel
+++ b/src/sys/lib/cm_fidl_validator/BUILD.bazel
@@ -21,14 +21,8 @@
     ],
     crate_name = "cm_fidl_validator",
     edition = "2024",
-    test_deps = [
-        "//vendor/fuchsia/sdk/fidl/fuchsia.data:fuchsia.data_rust",
-        "//vendor/fuchsia/sdk/fidl/fuchsia.io:fuchsia.io_rust",
-        "@rust_crates//vendor:proptest",
-        "@rust_crates//vendor:regex",
-        "@rust_crates//vendor:test-case",
-        "@rust_crates//vendor:url",
-    ],
+    # Overlay: unit tests are milestone M16 (patch 0001).
+    test_deps = [],
     visibility = [
         "//vendor/fuchsia:__subpackages__",
     ],
