#!/bin/bash
# SPDX-FileCopyrightText: 2026 Curtis Galloway
# SPDX-License-Identifier: Apache-2.0
#
# Runs the Bazel release named in .bazelversion, downloading it once from the official
# GitHub release and checking it against scripts/bazel.sha256 (the format of GitHub's
# own bazel-<v>-linux-x86_64.sha256 file). Build host is linux-amd64 only (design C5).
#
# The version is the Bazel that fuchsia.git itself pins at the lock's fuchsia_revision
# (manifests/jiri.lock, fuchsia/third_party/3pp/bazel); see docs/evidence/M2.md.
# Regenerating for a new release refreshes .bazelversion and scripts/bazel.sha256.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
version="$(tr -d '[:space:]' < "${root}/.bazelversion")"
name="bazel-${version}-linux-x86_64"
expected="$(awk -v n="${name}" '$2 == n { print $1 }' "${root}/scripts/bazel.sha256")"
if [[ -z "${expected}" ]]; then
  echo "scripts/bazel: no SHA-256 for ${name} in scripts/bazel.sha256" >&2
  exit 1
fi
if [[ "$(uname -s)-$(uname -m)" != "Linux-x86_64" ]]; then
  echo "scripts/bazel: build host must be linux x86_64 (design C5)" >&2
  exit 1
fi

cache="${XDG_CACHE_HOME:-${HOME}/.cache}/fuchsia-rust-sdk/bazel"
bin="${cache}/${name}-${expected}"
if [[ ! -x "${bin}" ]]; then
  mkdir -p "${cache}"
  tmp="$(mktemp "${cache}/.${name}.XXXXXX")"
  trap 'rm -f "${tmp}"' EXIT
  url="https://github.com/bazelbuild/bazel/releases/download/${version}/${name}"
  echo "scripts/bazel: downloading ${url}" >&2
  curl -fsSL --retry 3 -o "${tmp}" "${url}"
  actual="$(sha256sum "${tmp}" | cut -d' ' -f1)"
  if [[ "${actual}" != "${expected}" ]]; then
    echo "scripts/bazel: ${name}: SHA-256 ${actual}, expected ${expected}" >&2
    exit 1
  fi
  chmod 0755 "${tmp}"
  mv -f "${tmp}" "${bin}"
  trap - EXIT
fi

# Environment profile (design C6): after a command that can fetch, apply the profile's
# repository-cache policy. Under the hosted profile this removes the IDK tarball (3 GB)
# that Bazel keeps in its repository cache after fetching @fuchsia_idk; under a profile
# that caches it (large-disk), scripts/disk_report.py does nothing. See
# scripts/overlay_profile.py. Set OVERLAY_NO_PRUNE=1 to skip this step.
startup=()
command=""
for arg in "$@"; do
  if [[ "${arg}" == -* ]]; then
    startup+=("${arg}")
  else
    command="${arg}"
    break
  fi
done
case "${command}" in
  build|test|run|coverage|fetch|query|cquery|aquery|sync|mod|vendor) ;;
  *) exec "${bin}" "$@" ;;
esac
status=0
"${bin}" "$@" || status=$?
if [[ -z "${OVERLAY_NO_PRUNE:-}" ]]; then
  if repo_cache="$("${bin}" "${startup[@]}" info repository_cache 2>/dev/null)" &&
      [[ -n "${repo_cache}" ]]; then
    python3 "${root}/scripts/disk_report.py" --prune-cache "${repo_cache}" ||
      echo "scripts/bazel: warning: the repository-cache policy was not applied" >&2
  fi
fi
exit "${status}"
