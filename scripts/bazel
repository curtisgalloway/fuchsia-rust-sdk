#!/bin/bash
# SPDX-FileCopyrightText: 2026 Curtis Galloway
# SPDX-License-Identifier: Apache-2.0
#
# Runs the Bazel release named in .bazelversion, downloading it once from the official
# GitHub release and checking it against scripts/bazel.sha256 (the format of GitHub's
# own bazel-<v>-linux-x86_64.sha256 file). Build host is linux-amd64 only (design C5).
#
# The version matches the Bazel that sdk-samples/drivers used for this release (see
# docs/evidence/M2.md); regenerating for a new release refreshes both files.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
version="$(tr -d '[:space:]' < "${root}/.bazelversion")"
name="bazel-${version}-linux-x86_64"
expected="$(awk -v n="${name}" '$2 == n { print $1 }' "${root}/scripts/bazel.sha256")"
if [[ -z "${expected}" ]]; then
  echo "scripts/bazel: no SHA-256 for ${name} in scripts/bazel.sha256" >&2
  exit 1
fi
if [[ "$(uname -s)-$(uname -m)" != "Linux-x86_64" ]]; then
  echo "scripts/bazel: build host must be linux x86_64 (design C5)" >&2
  exit 1
fi

cache="${XDG_CACHE_HOME:-${HOME}/.cache}/fuchsia-rust-sdk/bazel"
bin="${cache}/${name}-${expected}"
if [[ ! -x "${bin}" ]]; then
  mkdir -p "${cache}"
  tmp="$(mktemp "${cache}/.${name}.XXXXXX")"
  trap 'rm -f "${tmp}"' EXIT
  url="https://github.com/bazelbuild/bazel/releases/download/${version}/${name}"
  echo "scripts/bazel: downloading ${url}" >&2
  curl -fsSL --retry 3 -o "${tmp}" "${url}"
  actual="$(sha256sum "${tmp}" | cut -d' ' -f1)"
  if [[ "${actual}" != "${expected}" ]]; then
    echo "scripts/bazel: ${name}: SHA-256 ${actual}, expected ${expected}" >&2
    exit 1
  fi
  chmod 0755 "${tmp}"
  mv -f "${tmp}" "${bin}"
  trap - EXIT
fi
exec "${bin}" "$@"
