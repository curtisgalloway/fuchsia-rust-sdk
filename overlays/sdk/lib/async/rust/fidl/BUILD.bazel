# Overlay BUILD file (design §4.2, R6; milestone M9a). Upstream has no BUILD.bazel here:
# this is fuchsia.git sdk/lib/async/rust/fidl/BUILD.gn at the lock's fuchsia_revision (b5274053cc0f,
# blob c6b96af8e596) translated by hand. scripts/regen.py copies it to
# vendor/fuchsia/sdk/lib/async/rust/fidl/BUILD.bazel. GN -> Bazel:
#   - the rustc_library's name, crate name, edition, version, sources and deps unchanged;
#     in-tree deps -> //vendor/fuchsia/<path>, //third_party/rust_crates:<c> ->
#     @rust_crates//vendor:<c>, C libraries -> the IDK's prebuilt @fuchsia_sdk//pkg/<name>
#     (//sdk/lib/async -> pkg/async, //sdk/lib/async-default -> pkg/async-default,
#     //src/devices/lib/driver:driver_runtime (the link stub) and
#     //src/devices/bin/driver_runtime -> pkg/driver_runtime_shared_lib, a cc_import of
#     libdriver_runtime.so with both its interface and its shared library (whether a
#     driver package ships the latter is milestone M10's question: the driver host
#     provides it));
#   - GN visibility "//<dir>/*" -> "//vendor/fuchsia/<dir>:__subpackages__", ":*" and
#     "//<dir>:*" -> "...:__pkg__"; no visibility -> public;
#   - configs += clippy_warn_all -> lint_config = //rules/lints:clippy_warn_all;
#   - vendored = True (--cap-lints=allow), as regen.py adds to every upstream Rust rule;
#   - Fuchsia-only (target_compatible_with): GN builds it for Fuchsia only (pilot 1's
#     closure reaches it in the fuchsia context only), and its C deps are Fuchsia-only;
#   - with_unit_tests kept; test_deps and the test, bindgen-golden and package targets
#     are not translated (unit tests are milestone M16).

load("//rules:rustc.bzl", "rustc_library")

package(default_applicable_licenses = ["//vendor/fuchsia:license"])

rustc_library(
    name = "fidl",
    crate_name = "libasync_fidl",
    srcs = ["src/lib.rs"],
    edition = "2024",
    lint_config = "//rules/lints:clippy_warn_all",
    target_compatible_with = ["@platforms//os:fuchsia"],
    vendored = True,
    version = "0.1.0",
    visibility = [
        "//vendor/fuchsia/examples:__subpackages__",
        "//vendor/fuchsia/sdk/lib/async/rust:__subpackages__",
        "//vendor/fuchsia/sdk/lib/driver/component/rust:__subpackages__",
        "//vendor/fuchsia/sdk/lib/driver/runtime/rust/fidl:__subpackages__",
        "//vendor/fuchsia/src/ui/lib/input_pipeline:__subpackages__",
    ],
    with_unit_tests = True,
    deps = [
        "//vendor/fuchsia/sdk/lib/async/rust",
        "//vendor/fuchsia/sdk/lib/async/rust/sys",
        "//vendor/fuchsia/sdk/rust/zx",
        "//vendor/fuchsia/src/lib/fidl/rust_next/fidl_next",
        "@rust_crates//vendor:futures",
    ],
    # GN test_deps (M16): :fuchsia.examples.gizmo_rust_next, //sdk/lib/driver/runtime/rust,
    # //sdk/lib/driver/runtime/rust/env, //src/devices/bin/driver_runtime, //src/lib/fuchsia.
)

# Not translated (tests, M16): rustc_test("libasync_rust_fidl_integration_test") and the
# test-only FIDL library fidl("fuchsia.examples.gizmo") over gizmo.test.fidl.
