#
# Overlay BUILD file (design §4.2, R6; milestone M9c). Upstream has no BUILD.bazel here:
# this is fuchsia.git src/lib/process_builder/BUILD.gn at the lock's fuchsia_revision
# (b5274053cc0f, blob 6b2705cc4fe3) translated by hand. scripts/regen.py copies it to
# vendor/fuchsia/src/lib/process_builder/BUILD.bazel. GN -> Bazel, as the M9a overlays
# (overlays/sdk/lib/driver/runtime/rust/BUILD.bazel):
#   - the rustc_library's name, crate name, edition, sources and deps unchanged (GN
#     sets no version: rustc_library.gni ignores it); in-tree deps ->
#     //vendor/fuchsia/<path>, //third_party/rust_crates:<c> -> @rust_crates//vendor:<c>;
#   - no visibility -> public;
#   - vendored = True (--cap-lints=allow), as regen.py adds to every upstream Rust rule;
#   - Fuchsia-only (target_compatible_with): pilot 1's closure reaches it in the fuchsia
#     context only, and its deps (fidl, fuchsia-async) are Fuchsia-only here;
#   - with_unit_tests kept; test_deps and the test FIDL library, test binary, test
#     package and group are not translated (unit tests are milestone M16).

load("//rules:rustc.bzl", "rustc_library")

package(default_applicable_licenses = ["//vendor/fuchsia:license"])

rustc_library(
    name = "process_builder",
    crate_name = "process_builder",
    srcs = [
        "src/elf_load.rs",
        "src/lib.rs",
        "src/process_args.rs",
        "src/process_builder.rs",
        "src/util.rs",
    ],
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    vendored = True,
    visibility = ["//visibility:public"],
    with_unit_tests = True,
    deps = [
        "//vendor/fuchsia/sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//vendor/fuchsia/sdk/fidl/fuchsia.ldsvc:fuchsia.ldsvc_rust",
        "//vendor/fuchsia/sdk/rust/zx",
        "//vendor/fuchsia/src/lib/elf_parse",
        "//vendor/fuchsia/src/lib/fidl/rust/fidl",
        "//vendor/fuchsia/src/lib/fuchsia-async",
        "//vendor/fuchsia/src/lib/fuchsia-runtime",
        "@rust_crates//vendor:anyhow",
        "@rust_crates//vendor:futures",
        "@rust_crates//vendor:static_assertions",
        "@rust_crates//vendor:thiserror",
        "@rust_crates//vendor:zerocopy",
    ],
    # GN test_deps (M16): :test-util-fidl_rust, //src/lib/fdio/rust:fdio,
    # //src/storage/lib/vfs/rust:vfs, //third_party/rust_crates:assert_matches.
)
