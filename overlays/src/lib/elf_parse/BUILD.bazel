#
# Overlay BUILD file (design §4.2, R6; milestone M9c). Upstream has no BUILD.bazel here:
# this is fuchsia.git src/lib/elf_parse/BUILD.gn at the lock's fuchsia_revision
# (b5274053cc0f, blob 6dc28b62f01b) translated by hand. scripts/regen.py copies it to
# vendor/fuchsia/src/lib/elf_parse/BUILD.bazel. GN -> Bazel, as the M9a overlays
# (overlays/sdk/lib/driver/runtime/rust/BUILD.bazel):
#   - the rustc_library's name, crate name, edition, sources and deps unchanged (GN
#     sets no version: rustc_library.gni ignores it); in-tree deps ->
#     //vendor/fuchsia/<path>, //third_party/rust_crates:<c> -> @rust_crates//vendor:<c>;
#     GN takes the proc macro
#     num-derive in deps, rules_rust in proc_macro_deps (M9b);
#   - GN inputs -> compile_data (the three test-utils/*.bin, include_bytes! in the
#     #[cfg(test)] module only);
#   - no visibility -> public;
#   - vendored = True (--cap-lints=allow), as regen.py adds to every upstream Rust rule;
#   - Fuchsia-only (target_compatible_with): pilot 1's closure reaches it in the fuchsia
#     context only;
#   - with_unit_tests kept; test_deps and the test executable, test package and group
#     are not translated (unit tests are milestone M16).

load("//rules:rustc.bzl", "rustc_library")

package(default_applicable_licenses = ["//vendor/fuchsia:license"])

rustc_library(
    name = "elf_parse",
    crate_name = "elf_parse",
    srcs = ["src/lib.rs"],
    compile_data = [
        "test-utils/elf_aarch64_file-header.bin",
        "test-utils/elf_riscv64_file-header.bin",
        "test-utils/elf_x86-64_file-header.bin",
    ],
    edition = "2024",
    proc_macro_deps = ["@rust_crates//vendor:num-derive"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    vendored = True,
    visibility = ["//visibility:public"],
    with_unit_tests = True,
    deps = [
        "//vendor/fuchsia/sdk/rust/zx",
        "@rust_crates//vendor:bitflags",
        "@rust_crates//vendor:num-traits",
        "@rust_crates//vendor:static_assertions",
        "@rust_crates//vendor:thiserror",
        "@rust_crates//vendor:zerocopy",
    ],
    # GN test_deps (M16): //src/lib/fdio/rust:fdio, //third_party/rust_crates:anyhow,
    # //third_party/rust_crates:assert_matches.
)
