#
# Overlay BUILD file (design §4.2, R6; milestone M9b). Upstream has no BUILD.bazel here:
# this is fuchsia.git src/lib/fuchsia-component/escrow/BUILD.gn at the lock's
# fuchsia_revision (b5274053cc0f, blob 19145c7c3a27) translated by hand.
# scripts/regen.py copies it to
# vendor/fuchsia/src/lib/fuchsia-component/escrow/BUILD.bazel. GN -> Bazel, as the M9a
# overlays
# (overlays/sdk/lib/driver/runtime/rust/BUILD.bazel):
#   - the rustc_library's name, crate name, edition, version, sources, features and deps
#     unchanged; in-tree deps -> //vendor/fuchsia/<path>, //third_party/rust_crates:<c>
#     -> @rust_crates//vendor:<c>;
#   - GN visibility "//<dir>/*" -> "//vendor/fuchsia/<dir>:__subpackages__", ":*" and
#     "//<dir>:*" -> "...:__pkg__"; no visibility -> public;
#   - vendored = True (--cap-lints=allow), as regen.py adds to every upstream Rust rule;
#   - Fuchsia-only (target_compatible_with): pilot 1's closure reaches it in the fuchsia
#     context only, and its deps (fidl, fuchsia-async) are Fuchsia-only here;
#   - with_unit_tests kept; test_deps and the test and package targets are not translated
#     (unit tests are milestone M16).

load("//rules:rustc.bzl", "rustc_library")

package(default_applicable_licenses = ["//vendor/fuchsia:license"])

rustc_library(
    name = "escrow",
    crate_name = "fuchsia_component_escrow",
    srcs = ["src/lib.rs"],
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    vendored = True,
    version = "0.1.0",
    visibility = ["//visibility:public"],
    with_unit_tests = True,
    deps = [
        "//vendor/fuchsia/sdk/fidl/fuchsia.component.sandbox:fuchsia.component.sandbox_rust",
        "//vendor/fuchsia/sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//vendor/fuchsia/sdk/fidl/fuchsia.process.lifecycle:fuchsia.process.lifecycle_rust",
        "//vendor/fuchsia/src/lib/fidl/rust/fidl",
        "//vendor/fuchsia/src/lib/fuchsia-async",
        "//vendor/fuchsia/src/lib/fuchsia-component/runtime",
        "//vendor/fuchsia/src/lib/fuchsia-runtime",
        "//vendor/fuchsia/src/lib/fuchsia-sync",
        "@rust_crates//vendor:anyhow",
        "@rust_crates//vendor:futures",
    ],
)
