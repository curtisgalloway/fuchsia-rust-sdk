#
# Overlay BUILD file (design §4.2, R6; milestone M9c). Upstream has no BUILD.bazel here:
# this is fuchsia.git src/sys/lib/namespace/BUILD.gn at the lock's fuchsia_revision
# (b5274053cc0f, blob 711701a0cfeb) translated by hand. scripts/regen.py copies it to
# vendor/fuchsia/src/sys/lib/namespace/BUILD.bazel. GN -> Bazel, as the M9a overlays
# (overlays/sdk/lib/driver/runtime/rust/BUILD.bazel):
#   - the rustc_library's name, crate name, edition, sources and deps unchanged (GN
#     sets no version: rustc_library.gni ignores it); in-tree deps ->
#     //vendor/fuchsia/<path>, //third_party/rust_crates:<c> -> @rust_crates//vendor:<c>;
#   - GN's `if (is_fuchsia)` deps (zx, process_builder, vfs) are unconditional: the
#     target is Fuchsia-only here;
#   - no visibility -> public;
#   - vendored = True (--cap-lints=allow), as regen.py adds to every upstream Rust rule;
#   - Fuchsia-only (target_compatible_with): pilot 1's closure reaches it in the fuchsia
#     context only, and its deps (fidl, the is_fuchsia ones) are Fuchsia-only here;
#   - with_unit_tests kept; test_deps and the test package and group are not translated
#     (unit tests are milestone M16).

load("//rules:rustc.bzl", "rustc_library")

package(default_applicable_licenses = ["//vendor/fuchsia:license"])

rustc_library(
    name = "namespace",
    crate_name = "namespace",
    srcs = [
        "src/lib.rs",
        "src/tree.rs",
    ],
    edition = "2024",
    target_compatible_with = ["@platforms//os:fuchsia"],
    vendored = True,
    visibility = ["//visibility:public"],
    with_unit_tests = True,
    deps = [
        "//vendor/fuchsia/sdk/fidl/fuchsia.component:fuchsia.component_rust",
        "//vendor/fuchsia/sdk/fidl/fuchsia.component.runner:fuchsia.component.runner_rust",
        "//vendor/fuchsia/sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//vendor/fuchsia/sdk/fidl/fuchsia.process:fuchsia.process_rust",
        "//vendor/fuchsia/src/lib/fidl/rust/fidl",
        "//vendor/fuchsia/src/sys/lib/cm_types",
        "@rust_crates//vendor:thiserror",
        # GN: if (is_fuchsia)
        "//vendor/fuchsia/sdk/rust/zx",
        "//vendor/fuchsia/src/lib/process_builder",
        "//vendor/fuchsia/src/storage/lib/vfs/rust:vfs",
    ],
    # GN test_deps (M16): //src/lib/fuchsia, //third_party/rust_crates:assert_matches;
    # if (is_fuchsia): //src/lib/fuchsia-fs, //src/storage/lib/vfs/rust:vfs.
)
