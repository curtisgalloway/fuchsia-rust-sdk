common --enable_bzlmod
common --noenable_workspace

# Fuchsia flag aliases (as fuchsia-infra-bazel-rules config/common_config.bazelrc).
build --flag_alias=override_fuchsia_api_level=@fuchsia_sdk//flags:fuchsia_api_level
build --flag_alias=default_fuchsia_api_level=@fuchsia_sdk//flags:repository_default_fuchsia_api_level

# Give each target platform its own output directory (as upstream's template.bazelrc
# does), so x64, arm64 and host outputs do not overwrite each other in bazel-out/.
common --experimental_platform_in_output_dir=True

# Target the release's in-development API level, as sdk-samples/drivers does: hardware
# FIDL is @available(added=HEAD) (design C3).
build --default_fuchsia_api_level=HEAD

# Fuchsia targets. rules_fuchsia's packaging rules pick the API level up from the default
# above through a transition; bare rules_rust targets have no such transition, so the
# configs set it directly. Same level, so packaged and unpackaged builds agree.
build:fuchsia --override_fuchsia_api_level=HEAD
build:fuchsia_x64 --config=fuchsia
build:fuchsia_x64 --platforms=@rules_fuchsia//fuchsia/constraints/platforms:fuchsia_x64
build:fuchsia_arm64 --config=fuchsia
build:fuchsia_arm64 --platforms=@rules_fuchsia//fuchsia/constraints/platforms:fuchsia_arm64

# rules_fuchsia's fuchsia_package transition (fuchsia/private/fuchsia_transition.bzl)
# takes the target CPU from --cpu, not --platforms, so without these an arm64 build
# packages x64 binaries (M10). It also sets the options below; giving the configs the same
# values makes the transition a no-op, so a package holds the very targets the config
# builds instead of a second copy in a "-ST-" output directory. 4292870144 is the u32 of
# API level HEAD (special_api_levels.HEAD.as_u32 in the IDK's version_history.json), the
# level both configs target; //tests/api_level:bazelrc_head_u32_test checks it.
build:fuchsia --copt=--debug
build:fuchsia --copt=-ffuchsia-api-level=4292870144
build:fuchsia --strip=never
build:fuchsia_x64 --cpu=x86_64
build:fuchsia_arm64 --cpu=aarch64
