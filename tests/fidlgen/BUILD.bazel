# Tests for the FIDL generators as Bazel host tools (design R5, milestone M7). Both
# generators are host tools; everything here is host-only.
#
# 1. Goldens: each generator, run on upstream fidlc's IR goldens for five test
#    libraries, must reproduce upstream's own golden output byte for byte (upstream's
#    golden tests at the lock revision). testdata/ holds the IR goldens and the
#    fidlgen_rust_next goldens (copied from fuchsia.git, recipe in docs/evidence/M7.md);
#    the fidlgen_rust goldens are vendored with its source by scripts/regen.py.
# 2. fuchsia.mem: the IDK's fidlc compiles the IDK's fuchsia.mem (with zx) at HEAD, and
#    both generators produce every crate from that IR.

load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load(":fidlgen.bzl", "contains_test", "fidlgen_rust_outputs")

_GOLDEN_LIBRARIES = [
    "bits",
    "enum",
    "handles",
    "protocols",
    "struct",
]

_GOLDENS = {
    "rust": "//vendor/fuchsia/tools/fidl/fidlgen_rust:goldens/{n}.rs.golden",
    "rust_common": "//vendor/fuchsia/tools/fidl/fidlgen_rust:goldens/{n}_common.rs.golden",
    "rust_next": "testdata/rust_next/{n}.rs.golden",
    "rust_next_common": "testdata/rust_next/{n}_common.rs.golden",
}

# The test libraries' GN arguments (tools/fidl/fidlc/testdata/fidl_golden_library.gni
# sets enable_api_coverage; testdata/BUILD.gn sets contains_drivers for handles).
[
    fidlgen_rust_outputs(
        name = "golden_" + n,
        ir = "testdata/ir/%s.json.golden" % n,
        library = "test." + n,
        rust_args = ["--api-coverage=true"] + (["--include-drivers"] if n == "handles" else []),
    )
    for n in _GOLDEN_LIBRARIES
]

[
    diff_test(
        name = "golden_%s_%s_test" % (n, flavor),
        file1 = golden.format(n = n),
        file2 = ":golden_%s_%s" % (n, flavor),
        target_compatible_with = HOST_CONSTRAINTS,
    )
    for n in _GOLDEN_LIBRARIES
    for flavor, golden in _GOLDENS.items()
]

# --- fuchsia.mem from the IDK ----------------------------------------------------------

_ZX = ["@fuchsia_sdk//fidl/zx:" + f for f in [
    "overview.fidl",
    "rights.fidl",
    "zx_common.fidl",
]]

_FUCHSIA_MEM = ["@fuchsia_sdk//fidl/fuchsia.mem:" + f for f in [
    "buffer.fidl",
    "overview.fidl",
    "range.fidl",
]]

# As rules_fuchsia's fuchsia_fidl_library runs fidlc (at the overlay's level, HEAD).
genrule(
    name = "fuchsia_mem_ir",
    testonly = True,
    srcs = _ZX + _FUCHSIA_MEM,
    outs = ["fuchsia.mem.fidl.json"],
    cmd = " ".join([
        "$(execpath @fuchsia_sdk//tools:x64/fidlc)",
        "--json $@",
        "--name fuchsia.mem",
        "--available fuchsia:HEAD",
        "--files",
        " ".join(["$(execpath %s)" % f for f in _ZX]),
        "--files",
        " ".join(["$(execpath %s)" % f for f in _FUCHSIA_MEM]),
    ]),
    target_compatible_with = HOST_CONSTRAINTS,
    tools = ["@fuchsia_sdk//tools:x64/fidlc"],
)

fidlgen_rust_outputs(
    name = "fuchsia_mem",
    ir = ":fuchsia_mem_ir",
    library = "fuchsia.mem",
)

# fuchsia.mem declares the resource structs Buffer and Range and the resource union Data,
# so they are in the regular crates, and the _common crates are (nearly) empty; the
# regular crates re-export their _common crate, named as the GN templates name it. M8
# compiles these crates.
_FUCHSIA_MEM_EXPECTED = {
    "rust": [
        "pub use fidl_fuchsia_mem_common::*;",
        "pub struct Buffer {",
        "pub struct Range {",
        "pub enum Data {",
        "pub vmo: fidl::Vmo,",
    ],
    "rust_common": [
        "// WARNING: This file is machine generated by fidlgen.",
        "use fidl::encoding::{MessageBufFor, ProxyChannelBox, ResourceDialect};",
        "mod internal {",
    ],
    "rust_next": [
        "pub use fidl_next_common_fuchsia_mem::*;",
        "pub mod natural {",
        "pub mod wire {",
        "    pub struct Buffer {",
        "    pub struct Range {",
        "    pub enum Data {",
        # A ' in an expected line (contains_test quotes it for the shell).
        "::fidl_next::Encode<crate::wire::Data<'static>, ___E> for Data",
    ],
    "rust_next_common": [
        "pub mod natural {}",
        "pub mod wire {}",
        "pub mod wire_optional {}",
        "pub mod generic {}",
    ],
}

[
    contains_test(
        name = "fuchsia_mem_%s_test" % flavor,
        src = ":fuchsia_mem_" + flavor,
        expected = expected,
        target_compatible_with = HOST_CONSTRAINTS,
    )
    for flavor, expected in _FUCHSIA_MEM_EXPECTED.items()
]

# The binding rule (//rules:fidl_rust_next.bzl, milestone M8b) runs fidlgen_rust_next with
# the arguments FLAVORS gives it, which the golden tests above check against upstream's:
# on fuchsia.mem both produce the same crates, byte for byte (the rule's IR is its host
# IR, at PLATFORM; fuchsia.mem has no API-level differences in it).
[
    diff_test(
        name = "fuchsia_mem_%s_rule_parity_test" % flavor,
        file1 = ":fuchsia_mem_" + flavor,
        file2 = "//vendor/fuchsia/sdk/fidl/fuchsia.mem:fuchsia.mem_%s_fidlgen" % flavor,
        target_compatible_with = HOST_CONSTRAINTS,
    )
    for flavor in ("rust_next", "rust_next_common")
]
