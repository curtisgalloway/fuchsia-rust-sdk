"""The overlay: out-of-tree Rust drivers for a Fuchsia release (docs/design.md).

Every per-release input comes from overlay.lock.json through the two module extensions
in //toolchain; nothing in this file names a release. Bazel's own version is pinned by
.bazelversion (run it with scripts/bazel).
"""

module(
    name = "fuchsia_rust_sdk",
    version = "0.0.0",
)

# BCR dependencies that rules_fuchsia and the generated @fuchsia_sdk load from. Versions
# follow fuchsia-infra-bazel-rules, which sdk-samples/drivers uses at this release,
# except rules_cc, which matches fuchsia.git's pin at the lock revision
# (build/bazel/toplevel.MODULE.bazel). Under Bazel 8 rules_cc's cc_* rules are the
# native ones, so the choice has no functional effect here. platforms is 1.1.0, the
# version rules_go (below) requires and fuchsia.git pins (M7; it was 1.0.0).
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.19")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_python", version = "1.1.0")

# Cloud containers run as root; rules_python's hermetic interpreter refuses root unless
# told otherwise (fuchsia-cloud-dev README, container workaround 4).
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    ignore_root_user_error = True,
    is_default = True,
    python_version = "3.11",
)

# rules_rust at upstream's version, with upstream's one patch (design F4), applied as
# fuchsia.git's build/bazel/toplevel.MODULE.bazel applies it.
bazel_dep(name = "rules_rust", version = "0.69.0")
single_version_override(
    module_name = "rules_rust",
    patch_strip = 4,
    patches = ["//patches/rules_rust:0001-rules_rust-workaround-bazelbuild-issues-28286.patch"],
    version = "0.69.0",
)

# Pinned by overlay.lock.json: rules_fuchsia, the IDK, the Rust toolchain, the Go SDK and
# the prebuilt fidlgen_rust_next.
lock_repos = use_extension("//toolchain:repositories.bzl", "lock_repos")
use_repo(lock_repos, "fidlgen_rust_next", "fuchsia_go", "fuchsia_idk", "fuchsia_rust_toolchain", "rules_fuchsia")

# rules_go builds fidlgen_rust from vendored source (M7), at the version and under the
# repo name fuchsia.git uses at the lock revision (build/bazel/toplevel.MODULE.bazel).
# The SDK is the release's own Go (the lock's "go" field, @fuchsia_go), wrapped as
# upstream wraps its prebuilt; no Go SDK or module is downloaded from anywhere else.
bazel_dep(name = "rules_go", version = "0.61.1", repo_name = "io_bazel_rules_go")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.wrap(root_file = "@fuchsia_go//:README.md")

# Generated with rules_fuchsia's own rules: @fuchsia_sdk (from the IDK) and @fuchsia_clang.
fuchsia_repos = use_extension("//toolchain:fuchsia.bzl", "fuchsia_repos")
use_repo(fuchsia_repos, "fuchsia_clang", "fuchsia_sdk", "fuchsia_sdk_toolchain")

# API levels for the Rust toolchains' --cfg=fuchsia_api_level_* flags (design R3,
# rules/rustc_api_level.bzl): from the IDK's version_history.json, and from two pinned
# copies that the golden test in tests/api_level runs the same code on.
api_levels = use_extension("//toolchain:api_levels.bzl", "api_levels")
api_levels.from_version_history(
    name = "fuchsia_api_levels",
    version_history = "@fuchsia_idk//:version_history.json",
)
api_levels.from_version_history(
    name = "api_levels_testdata_idk",
    version_history = "//tests/api_level:testdata/idk_version_history.json",
)
api_levels.from_version_history(
    name = "api_levels_testdata_sdk",
    version_history = "//tests/api_level:testdata/sdk_version_history.json",
)
use_repo(api_levels, "api_levels_testdata_idk", "api_levels_testdata_sdk", "fuchsia_api_levels")

register_toolchains("@fuchsia_sdk_toolchain//:all")
register_toolchains("@fuchsia_clang//:all")

# The release's Rust toolchains (toolchain/rust.BUILD.bazel): linux-x64 host, x64 and
# arm64 Fuchsia. Registered by the root module, so they take precedence over the default
# toolchains rules_rust registers (which download from static.rust-lang.org).
register_toolchains("@fuchsia_rust_toolchain//:all")

# crates.io crates that vendored Fuchsia code depends on (@rust_crates), from
# third_party/crates/, which scripts/regen.py generates: each crate is downloaded by the
# SHA-256 the release's Cargo.lock gives it.
crates = use_extension("//toolchain:crates.bzl", "crates")
use_repo(crates, "rust_crates")
