#
# Overlay BUILD file (design §4.2, R6; milestone M9b). Upstream has no BUILD.bazel here:
# this is fuchsia.git src/storage/lib/vfs/rust/BUILD.gn at the lock's fuchsia_revision
# (b5274053cc0f, blob 8b84c6e00779) translated by hand. scripts/regen.py copies it to
# vendor/fuchsia/src/storage/lib/vfs/rust/BUILD.bazel. GN -> Bazel, as the M9a overlays
# (overlays/sdk/lib/driver/runtime/rust/BUILD.bazel):
#   - the rustc_dylib's name, crate name, edition, version, sources, features and deps
#     unchanged (built as an rlib: see below); in-tree deps -> //vendor/fuchsia/<path>,
#     //third_party/rust_crates:<c> -> @rust_crates//vendor:<c>, and the C library
#     //zircon/system/ulib/trace-engine (GN public_deps) -> the IDK's prebuilt
#     @fuchsia_sdk//pkg/trace-engine, as regen.py maps it; GN deps that are proc macros
#     -> proc_macro_deps (rules_rust keeps them apart; GN does not);
#   - GN visibility "//<dir>/*" -> "//vendor/fuchsia/<dir>:__subpackages__", ":*" and
#     "//<dir>:*" -> "...:__pkg__"; no visibility -> public;
#   - vendored = True (--cap-lints=allow), as regen.py adds to every upstream Rust rule;
#   - Fuchsia-only (target_compatible_with): pilot 1's closure reaches it in the fuchsia
#     context only, and its deps (fidl, fuchsia-async) are Fuchsia-only here;
#   - with_unit_tests kept; test_deps and the test and package targets are not translated
#     (unit tests are milestone M16).
#
# The Fuchsia branch of GN's file is translated (`if (is_fuchsia) { rustc_dylib("vfs") }`,
# with common_vfs_args forwarded); vfs_rust_uses_log = is_host is false there, so no log
# dep and no "use_log" feature. Decisions (milestone M9b; see docs/evidence/M9b.md):
#   - GN builds this crate as a Rust dylib (crate_type "dylib", output libvfs_rust.so,
#     which build/drivers/driver_shared_library_allowlist lets a driver load). The overlay
#     builds an rlib: rules_rust has no dylib crate type (rust_shared_library is a cdylib).
#     The code is the same, but its process-wide state is not shared: src/temp_clone.rs
#     keeps statics (CLONES, and STATE, which starts a 2-thread pool on first use), so each
#     binary that links vfs statically gets its own copies, where GN's drivers in one
#     driver host share those of the one libvfs_rust.so. Milestone M10's DT_NEEDED
#     comparison should expect libvfs_rust.so in the in-tree driver only.
#   - configs += //build/config/rust:bootfs (-Copt-level=s on Fuchsia) is not translated:
#     an optimization setting, like the rest of GN's configs (the overlay's toolchain
#     sets its own).
#   - Not translated: vfs_static (GN's rustc_library "vfs" with log and "use_log", for
#     filesystems only), the host rustc_library "vfs" (FDomain), and the tests.

load("//rules:rustc.bzl", "rustc_library")

package(default_applicable_licenses = ["//vendor/fuchsia:license"])

rustc_library(
    name = "vfs",
    crate_name = "vfs",
    srcs = [
        "src/common.rs",
        "src/directory.rs",
        "src/directory/common.rs",
        "src/directory/connection.rs",
        "src/directory/dirents_sink.rs",
        "src/directory/entry.rs",
        "src/directory/entry_container.rs",
        "src/directory/helper.rs",
        "src/directory/immutable.rs",
        "src/directory/immutable/connection.rs",
        "src/directory/immutable/simple.rs",
        "src/directory/immutable/simple/tests.rs",
        "src/directory/mutable.rs",
        "src/directory/mutable/connection.rs",
        "src/directory/read_dirents.rs",
        "src/directory/simple.rs",
        "src/directory/test_utils.rs",
        "src/directory/traversal_position.rs",
        "src/directory/watchers.rs",
        "src/directory/watchers/event_producers.rs",
        "src/directory/watchers/watcher.rs",
        "src/execution_scope.rs",
        "src/file.rs",
        "src/file/common.rs",
        "src/file/connection.rs",
        "src/file/simple.rs",
        "src/file/simple/tests.rs",
        "src/file/vmo.rs",
        "src/file/vmo/tests.rs",
        "src/lib.rs",
        "src/node.rs",
        "src/object_request.rs",
        "src/path.rs",
        "src/protocols.rs",
        "src/remote.rs",
        "src/remote/tests.rs",
        "src/request_handler.rs",
        "src/service.rs",
        "src/service/tests.rs",
        "src/service/tests/direct_connection.rs",
        "src/service/tests/node_reference.rs",
        "src/symlink.rs",
        "src/temp_clone.rs",
        "src/test_utils.rs",
        "src/test_utils/assertions.rs",
        "src/token_registry.rs",
        "src/tree_builder.rs",
    ],
    edition = "2024",
    # GN lists the proc macro paste in deps; rules_rust needs it in proc_macro_deps.
    proc_macro_deps = ["@rust_crates//vendor:paste"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    vendored = True,
    version = "0.1.0",
    visibility = ["//visibility:public"],
    with_unit_tests = True,
    deps = [
        "//vendor/fuchsia/sdk/fidl/fuchsia.io:fuchsia.io_rust_flex",
        "//vendor/fuchsia/sdk/rust/zx",
        "//vendor/fuchsia/sdk/rust/zx-status",
        "//vendor/fuchsia/src/lib/fdomain/client:flex_fidl",
        "//vendor/fuchsia/src/lib/fidl/rust/fidl",
        "//vendor/fuchsia/src/lib/fuchsia-async",
        "//vendor/fuchsia/src/lib/fuchsia-sync",
        "//vendor/fuchsia/src/storage/lib/trace",
        "//vendor/fuchsia/src/storage/lib/vfs/rust/name",
        # GN public_deps (see the header).
        "@fuchsia_sdk//pkg/trace-engine",
        "@rust_crates//vendor:anyhow",
        "@rust_crates//vendor:futures",
        "@rust_crates//vendor:itertools",
        "@rust_crates//vendor:libc",
        "@rust_crates//vendor:pin-project",
        "@rust_crates//vendor:slab",
        "@rust_crates//vendor:static_assertions",
        "@rust_crates//vendor:thiserror",
    ],
    # GN test_deps (M16): //src/lib/fuchsia, //third_party/rust_crates:assert_matches,
    # //third_party/rust_crates:bitflags, //third_party/rust_crates:log,
    # //src/lib/fuchsia-fs, //src/testing/fidl:placeholders_rust_flex,
    # //src/lib/fdomain/local:local_fidl_flex, //src/testing/fidl:placeholders_rust.
)
